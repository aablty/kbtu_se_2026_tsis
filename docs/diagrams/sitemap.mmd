%% Sitemap / Information Architecture — Nursultan Nurgali personal website
%% Pseudo-level: one real route, five in-page anchor sections, navigation relationships only.
graph TD
    Root["/ — single page: sticky Header (logo/nav, LanguageSwitcher, ThemeToggle) · five stacked sections · Footer (email, Telegram, Lucide credit)"]

    Home["#home — Home (hero/intro, portrait, short summary, nav into the rest of the page)"]
    About["#about — About & Education (KBTU major, previous-school note, gold medal)"]
    Interests["#interests — Interests & Activities (interests, activities, completed subjects)"]
    Future["#future-plans — Future Plans"]
    Contact["#contact — Contact (email, Telegram, contact form sent via Telegram Bot API)"]
    NotFound["/not-found — 404 (any path other than / or its hash)"]

    Root --> Home
    Root --> About
    Root --> Interests
    Root --> Future
    Root --> Contact
    Root -.-> NotFound

    Home -- anchor link, smooth scroll --> About
    Home -- anchor link, smooth scroll --> Interests
    Home -- anchor link, smooth scroll --> Future
    Home -- anchor link, smooth scroll --> Contact
    About -- anchor link, smooth scroll --> Interests
    Interests -- anchor link, smooth scroll --> Future
    Future -- anchor link, smooth scroll --> Contact
    Contact -- anchor link, smooth scroll --> Home

    %% The sticky Header/Footer wrap the whole page (not per-route), so LanguageSwitcher and
