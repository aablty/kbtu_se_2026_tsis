%% Component/structure diagram — pseudo-level boxes and relationships only.
%% No prop types, no CSS, no business logic.
graph TD
    subgraph "App shell"
        RootLayout["RootLayout (app/layout.tsx) — <html>/<body>, ThemeProvider, LanguageProvider"]
        Header["Header (sticky) — site nav (hash anchors), LanguageSwitcher, ThemeToggle"]
        Footer["Footer — email, Telegram link, Lucide attribution"]
    end

    subgraph "Single page (app/page.tsx — one Server Component)"
        HomeSection["#home section — no Reveal (above the fold, always visible)"]
        AboutSection["#about section"]
        InterestsSection["#interests section"]
        ProjectsSection["#projects section"]
        FutureSection["#future-plans section"]
        ContactSection["#contact section"]
    end

    subgraph "Shared presentation components"
        Card["Card (flat, 0 border-radius, subtle shadow)"]
        SectionHeading["SectionHeading"]
        Icon["Icon wrapper (Lucide)"]
        Reveal["Reveal (use client) — IntersectionObserver fade/slide-in wrapper"]
    end

    subgraph "Client-only interactive components"
        LanguageSwitcher["LanguageSwitcher (use client) → LanguageProvider"]
        ThemeToggle["ThemeToggle (use client) → ThemeProvider"]
        MobileNav["MobileNav (use client) — hash-anchor links"]
        ContactForm["ContactForm (use client) → POST /api/contact"]
    end

    subgraph "Cross-cutting providers/context"
        LanguageProvider["LanguageProvider (use client) — holds selected locale, persists to localStorage/cookie"]
        ThemeProvider["ThemeProvider (use client) — holds light/dark, persists to localStorage/cookie"]
    end

    subgraph "Content & server boundary"
        Dictionaries["Static dictionaries (content/{kk,ru,en}.ts)"]
        ContactRoute["API route: app/api/contact/route.ts (server only)"]
        TelegramClient["Telegram client helper (server-only module, reads BOT_TOKEN/CHAT_ID)"]
    end

    RootLayout --> Header
    RootLayout --> Footer
    RootLayout --> LanguageProvider
    RootLayout --> ThemeProvider
    RootLayout --> HomeSection
    RootLayout --> AboutSection
    RootLayout --> InterestsSection
    RootLayout --> ProjectsSection
    RootLayout --> FutureSection
    RootLayout --> ContactSection

    Header --> LanguageSwitcher
    Header --> ThemeToggle
    Header --> MobileNav
    LanguageSwitcher --> LanguageProvider
    ThemeToggle --> ThemeProvider

    AboutSection --> Reveal
    InterestsSection --> Reveal
    ProjectsSection --> Reveal
    FutureSection --> Reveal
    ContactSection --> Reveal

    HomeSection --> Card
    AboutSection --> Card
    InterestsSection --> Card
    ProjectsSection --> Card
    FutureSection --> Card
    ContactSection --> Card
    Card --> SectionHeading
    Card --> Icon

    HomeSection --> Dictionaries
    AboutSection --> Dictionaries
    InterestsSection --> Dictionaries
    ProjectsSection --> Dictionaries
    FutureSection --> Dictionaries
    ContactSection --> Dictionaries
    Dictionaries -. "selected by" .-> LanguageProvider

    ContactSection --> ContactForm
    ContactForm --> ContactRoute
    ContactRoute --> TelegramClient
