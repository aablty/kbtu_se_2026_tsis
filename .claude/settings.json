{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(cat *.env*)",
      "Bash(type .env*)",
      "Bash(type *.env*)",
      "Bash(more .env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(Get-Content .env*)",
      "Bash(Get-Content *.env*)",
      "Bash(cp .env*)",
      "Bash(cp *.env* *)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(cat .env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type .env*)",
      "PowerShell(type *.env*)",
      "PowerShell(Copy-Item .env*)"
    ]
  }
}
