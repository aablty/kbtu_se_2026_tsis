{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(.env.staging)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Bash(cat .env)",
      "Bash(cat .env.local*)",
      "Bash(cat .env.development*)",
      "Bash(cat .env.production*)",
      "Bash(cat .env.test*)",
      "Bash(cat .env.staging*)",
      "Bash(type .env)",
      "Bash(type .env.local*)",
      "Bash(type .env.development*)",
      "Bash(type .env.production*)",
      "Bash(type .env.test*)",
      "Bash(type .env.staging*)",
      "Bash(more .env)",
      "Bash(more .env.local*)",
      "Bash(less .env)",
      "Bash(less .env.local*)",
      "Bash(head .env)",
      "Bash(head .env.local*)",
      "Bash(tail .env)",
      "Bash(tail .env.local*)",
      "Bash(Get-Content .env)",
      "Bash(Get-Content .env.local*)",
      "Bash(Get-Content .env.development*)",
      "Bash(Get-Content .env.production*)",
      "Bash(Get-Content .env.test*)",
      "Bash(Get-Content .env.staging*)",
      "Bash(cp .env)",
      "Bash(cp .env.local*)",
      "Bash(cp .env.development*)",
      "Bash(cp .env.production*)",
      "Bash(cp .env.test*)",
      "Bash(cp .env.staging*)",
      "PowerShell(Get-Content .env)",
      "PowerShell(Get-Content .env.local*)",
      "PowerShell(Get-Content .env.development*)",
      "PowerShell(Get-Content .env.production*)",
      "PowerShell(Get-Content .env.test*)",
      "PowerShell(Get-Content .env.staging*)",
      "PowerShell(cat .env)",
      "PowerShell(cat .env.local*)",
      "PowerShell(type .env)",
      "PowerShell(type .env.local*)",
      "PowerShell(Copy-Item .env)",
      "PowerShell(Copy-Item .env.local*)"
    ]
  }
}
